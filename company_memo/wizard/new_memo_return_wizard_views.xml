<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_memo_return_wizard_form" model="ir.ui.view">
        <field name="name">memo.return.wizard.form</field>
        <field name="model">memo.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Unused Items">
                <sheet>
                    <group>
                        <field name="memo_id"/>
                        <field name="move_to_store"/>
                        <field name="company_id" readonly="1"/>


                        <field name="destination_location_id"
                               attrs="{'invisible': [('move_to_store', '=', False)],'required': [('move_to_store', '=', True)]}"
                               />

                        <field name="reason"
                               placeholder="Enter reason for returning unused items..."/>

                    </group>

                    <separator string="Items to Return"/>

                    <field name="line_ids">

                        <tree create="false"
                              delete="false"
                              edit="false">

                            <field name="product_id"/>

                            <field name="quantity_available"/>

                            <field name="used_qty"/>

                            <field name="return_qty"/>

                        </tree>

                    </field>

                </sheet>

                <footer>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm Return"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
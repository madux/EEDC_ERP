<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Restrict regular users to records of their own branch(es) -->
    <record id="rule_account_callover_own_branch" model="ir.rule">
        <field name="name">Account Callover: Own Branch Only</field>
        <field name="model_id" ref="model_account_callover"/>
        <field name="domain_force">['|', ('branch_id', '=', user.branch_id.id), ('branch_id', 'in', user.branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user')),(4, ref('ik_multi_branch.account_mda_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Partial access to people with many branches  -->
    <record id="rule_account_callover_allowed_branch_user_access" model="ir.rule">
        <field name="name">Account Callover: Allowed Branch Access</field>
        <field name="model_id" ref="model_account_callover"/>
        <field name="domain_force">['|', ('branch_id', '=', user.branch_id.id), ('branch_id', 'in', user.branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('ik_multi_branch.account_dia_user')), (4, ref('ik_multi_branch.account_mda_user'), (4, ref('ik_multi_branch.account_dto_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Full, unrestricted visibility for admins / major users -->
    <record id="rule_account_callover_full_access" model="ir.rule">
        <field name="name">Account Callover: Full Access</field>
        <field name="model_id" ref="model_account_callover"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('ik_multi_branch.account_major_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_report_employee_badge_portrait" model="ir.actions.report">
            <field name="name">Print Employee Card</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_addons.report_employee_badge_portrait_template</field>
            <field name="report_file">hr_addons.report_employee_badge_portrait_template</field>
            <field name="print_report_name">'Employee Card - %s' % (object.name)</field>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_employee_badge_portrait_template">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="o">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap');

                @page {
                    size: 54mm 86mm;
                    margin: 0mm;
                }
                
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                    background-color: #FFFFFF;
                    color: #1E293B;
                    -webkit-print-color-adjust: exact;
                }

                .badge-card {
                    width: 54mm;
                    height: 86mm;
                    box-sizing: border-box;
                    position: relative;
                    background: #FFFFFF;
                    overflow: hidden;
                    text-align: center;
                    page-break-after: always;
                    border: 1px solid #E2E8F0;
                }

                /* Header Styling */
                .company-header {
                    padding: 10px 6px 4px 6px;
                    text-align: center;
                }

                .company-logo {
                    max-height: 14mm;
                    max-width: 32mm;
                    object-fit: contain;
                    margin: 0 auto 2px auto;
                    display: block;
                }

                .company-name {
                    font-size: 7.5px;
                    font-weight: 700;
                    color: #0A192F; /* Deep Navy Blue */
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    margin-top: 2px;
                }

                .badge-subtitle {
                    font-size: 5.5px;
                    font-weight: 600;
                    color: #007ACE; /* Accent Blue */
                    letter-spacing: 1px;
                    text-transform: uppercase;
                }

                /* Photo Frame */
                .avatar-wrapper {
                    margin: 4px auto 6px auto;
                    display: inline-block;
                }

                .avatar-img {
                    width: 26mm;
                    height: 29mm;
                    object-fit: cover;
                    border-radius: 8px;
                    border: 2px solid #0A192F; /* Navy Blue Border */
                    box-shadow: 0 4px 6px -1px rgba(10, 25, 47, 0.1);
                }

                /* Modern Details Layout */
                .employee-info {
                    padding: 0 6px;
                }

                .employee-name {
                    font-size: 10px;
                    font-weight: 800;
                    color: #0A192F;
                    line-height: 1.1;
                    margin-bottom: 2px;
                }

                .job-title {
                    font-size: 7px;
                    font-weight: 600;
                    color: #007ACE;
                    margin-bottom: 6px;
                }

                /* Data Table Block */
                .info-grid {
                    background-color: #F8FAFC;
                    border: 1px solid #E2E8F0;
                    border-radius: 6px;
                    padding: 4px 6px;
                    margin: 0 4px;
                    text-align: left;
                }

                .info-row {
                    font-size: 6.5px;
                    color: #334155;
                    line-height: 1.35;
                    display: flex;
                    justify-content: space-between;
                }

                .info-label {
                    font-weight: 700;
                    color: #0A192F;
                }

                /* Modern Footer */
                .card-footer {
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    background-color: #0A192F; /* Navy Blue */
                    color: #FFFFFF;
                    font-size: 6px;
                    font-weight: 600;
                    padding: 4px 0;
                    letter-spacing: 0.5px;
                    display: flex;
                    justify-content: space-around;
                }

                /* Back Side Design */
                .back-header {
                    background-color: #0A192F;
                    color: #FFFFFF;
                    padding: 6px 4px;
                    font-size: 7px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                }

                .qr-container {
                    margin: 8px auto 4px auto;
                    padding: 4px;
                    background: #FFFFFF;
                    border: 1.5px solid #007ACE;
                    border-radius: 8px;
                    display: inline-block;
                }
            </style>

            <!-- ================= FRONT SIDE ================= -->
            <div class="badge-card">
                <!-- Top Center Logo & Subheading -->
                <div class="company-header">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="company-logo" alt="Company Logo"/>
                    <div class="company-name">
                        <t t-esc="o.company_id.name or 'COMPANY NAME'"/>
                    </div>
                    <div class="badge-subtitle">Official Identity Card</div>
                </div>

                <!-- Avatar Photo -->
                <div class="avatar-wrapper">
                    <img t-if="o.avatar_128" t-att-src="image_data_uri(o.avatar_128)" class="avatar-img" alt="Employee Photo"/>
                    <img t-if="not o.avatar_128" src="/web/static/img/placeholder.png" class="avatar-img" alt="Placeholder"/>
                </div>

                <!-- Employee Info (Modern Sans-Serif Font) -->
                <div class="employee-info">
                    <div class="employee-name">
                        <t t-esc="o.name"/>
                    </div>
                    <div class="job-title">
                        <t t-esc="o.job_title or 'Employee'"/>
                    </div>

                    <!-- Clean Info Box -->
                    <div class="info-grid">
                        <div class="info-row">
                            <span class="info-label">ID NO:</span>
                            <span><t t-esc="o.barcode or o.id"/></span>
                        </div>
                        <div class="info-row text-truncate">
                            <span class="info-label">DEPT:</span>
                            <span><t t-esc="o.department_id.name or 'N/A'"/></span>
                        </div>
                        <div class="info-row text-truncate">
                            <span class="info-label">EMAIL:</span>
                            <span><t t-esc="o.work_email or 'N/A'"/></span>
                        </div>
                    </div>
                </div>

                <!-- Navy Blue Footer -->
                <div class="card-footer">
                    <span>ACCESS AUTHORIZED</span>
                    <span>SINCE <t t-esc="o.create_date.strftime('%Y') if o.create_date else '2021'"/></span>
                </div>
            </div>

            <!-- ================= BACK SIDE ================= -->
            <div class="badge-card d-flex flex-column justify-content-between">
                <div>
                    <!-- Back Header -->
                    <div class="back-header">
                        TERMS OF USE &amp; VERIFICATION
                    </div>

                    <div style="padding: 8px 8px 0 8px;">
                        <p style="font-size: 5.8px; color: #475569; line-height: 1.3; margin-bottom: 6px;">
                            This card is the non-transferable property of <strong style="color: #0A192F;"><t t-esc="o.company_id.name"/></strong>. If found, please return immediately to the HR office.
                        </p>

                        <!-- Centered QR Code -->
                        <div class="qr-container">
                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', o.barcode or o.id, 120, 120)" 
                                 style="width: 24mm; height: 24mm; display: block;" 
                                 alt="Employee QR Code"/>
                        </div>

                        <div style="font-size: 6px; color: #0A192F; font-weight: 700; margin-top: 2px; letter-spacing: 0.5px;">
                            SCAN TO VERIFY EMPLOYEE
                        </div>
                    </div>
                </div>

                <!-- Back Info & Footer -->
                <div>
                    <div style="font-size: 6px; color: #334155; margin-bottom: 16px;">
                        <strong>Emergency Contact:</strong> <t t-esc="o.emergency_phone or o.work_phone or 'N/A'"/>
                    </div>
                    
                    <div class="card-footer" style="justify-content: center;">
                        <t t-esc="o.company_id.website or 'www.company.com'"/>
                    </div>
                </div>
            </div>
        </t>
    </t>
</template>
    </data>
</odoo>
<odoo>
  <data>
    
        <record id="view_multi_branch_form" model="ir.ui.view">
                <field name="name">multi.branch.form</field>
                <field name="model">multi.branch</field>
                <field name="arch" type="xml">
                    <form string="Branch Information" >
                        <sheet>
                            <group cols="4">
                                <group>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="company_id"/>
                                    <field name="districtCode"/>
                                    <field name="regionCode"/>
                                    <field name="telephone_no"/>
                                    <field name="parent_id" options="{'no_create': True, 'no_open': True}"/>
                                    
                                </group>
                                <group>
                                    <field name="active" />
                                    <field name="receivable_revenue_account_id" options="{'no_create': True, 'no_open': True}"/>

                                    <label for="street" string="Address"/>
                                    <div>
                                        <div class="o_address_format" name="div_address">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}' context="{'country_id': country_id, 'zip': zip}"/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                            <field name="account_asset_id" />
                                            <field name="account_depreciation_expense_id" />
                                            <field name="account_depreciation_id" />
                                        </div>
                                    </div>
                                </group>
                                <group>
                                    <field name="expense_journal_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="bank_journal_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="account_revenue_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="account_asset_id" options="{'no_create': True, 'no_open': True}"/>
                                    
                                    <field name="receivable_revenue_account_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="payable_account_id" options="{'no_create': True, 'no_open': True}"/>
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>

        <record id="view_multi_branch_tree" model="ir.ui.view">
            <field name="name">multi.branch.tree</field>
            <field name="model">multi.branch</field>
            <field name="arch" type="xml">
                <tree string="Branch Information">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="districtCode" string="Superedge District code"/>
                    <field name="regionCode" string="Region code"/>
                    <field name="city"/>
                    <field name="company_id"/>
                    <!-- <field name="is_testcenter" /> -->
                </tree>
            </field>
        </record>

        <record id="view_multi_branch_search" model="ir.ui.view">
            <field name="name">multi.branch.search</field>
            <field name="model">multi.branch</field>
			<field name="arch" type="xml">
				<search string="Filter"> 
					<field name="name"/>
					<field name="code"/>
					<field name="company_id"/>
                    <field name="districtCode"/>
                    <field name="regionCode"/>
					<group expand="0" string="Group By">
						<filter name="grp_company_id" string="Company Name" icon="terp-personal" domain="[]" context="{'group by':'company_id'}" />
					</group>
				</search>
			</field>
		</record>

        <record id="action_res_multi_branch_form" model="ir.actions.act_window">
            <field name="name">Districts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">multi.branch</field>
            <field name="view_mode">tree,form</field>
            <field name="context">
                {'group_by': 'company_id'}
            </field>

            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new Branch
              </p><p>
                Create and manage your company branches here.
              </p>
            </field>
        </record>

        <menuitem action="action_res_multi_branch_form" id="menu_action_res_branch_form" parent="base.menu_users"/>
  </data>
</odoo>